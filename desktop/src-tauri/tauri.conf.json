{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hudhud",
  "version": "0.1.0",
  "identifier": "app.hudhud.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hudhud",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 520,
        "backgroundColor": "#f4ecd8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/hudhud"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Saeid Sheikhi",
    "copyright": "Copyright 2026 Saeid Sheikhi. AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "category": "Education",
    "shortDescription": "A paper-like book reader that links your highlights across books",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
